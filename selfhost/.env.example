# REQUIRED — public origin where this instance is served (scheme + host, no trailing slash).
# This generates the OAuth client metadata and redirect URI, so it must be the
# exact URL people use to open the app (and be reachable from the internet).
VITE_PUBLIC_ORIGIN=https://qrs.example.com

# OPTIONAL — self-hosted CORS image proxy origin for logo images (see proxy/ in the repo).
#VITE_IMAGE_PROXY=https://cors-proxy.example.com

# OPTIONAL — host port to publish Caddy on (default 8080).
#PORT=8080

# OPTIONAL — set to your domain (e.g. qrs.example.com) to let Caddy issue and
# manage TLS automatically. Leave unset to serve plain HTTP on port 80.
#DOMAIN=qrs.example.com
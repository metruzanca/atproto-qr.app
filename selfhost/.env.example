# REQUIRED — where this instance is served. Accepts a full origin or a bare
# domain (https:// is assumed), no trailing slash. This is baked into the build:
# it generates the OAuth client metadata + redirect URI, and it is the base of
# every link written into a QR code, so previews and codes use your real domain.
VITE_DOMAIN=https://qrs.example.com

# OPTIONAL — "personal instance" mode. Set this to your own atproto handle to
# pin the deployment to that single account and give every code a short link
# like https://qrs.example.com/#name. Leave it empty for the regular
# multi-user app (links are https://qrs.example.com/your-handle/name).
# Sign-ins with any other account are handed over to the public atproto-qr.app.
#VITE_OWNER_HANDLE=you.example.com

# OPTIONAL — host port to publish Caddy on (default 8080).
#PORT=8080

# OPTIONAL — set to your domain (e.g. qrs.example.com) to let Caddy issue and
# manage TLS automatically. Leave unset to serve plain HTTP on port 80.
#DOMAIN=qrs.example.com
